{
  "name": "auto-loader",
  "version": "1.0.0",
  "private": true,
  "description": "Local app for Netradyne device + accessory initial load and shipment update",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test \"server/**/*.test.js\"",
    "postinstall": "playwright install chromium --with-deps || playwright install chromium || true"
  },
  "dependencies": {
    "express": "^4.21.2",
    "imapflow": "^1.0.171",
    "nodemailer": "^9.0.3",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.11"
  },
  "engines": {
    "node": ">=20"
  }
}
