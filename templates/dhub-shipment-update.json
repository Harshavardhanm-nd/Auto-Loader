    {
      "name": "device_category(required)",
      "source": "field.device_category",
      "required": true
    },
    {
      "name": "manufacturing_partner",
      "source": "field.manufacturing_partner"
    },
    {
      "name": "shipment_to_3pl",
      "source": "field.shipment_to_3pl"
