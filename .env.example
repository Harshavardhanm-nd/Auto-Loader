# Auto_Loader — NON-SECRET config only.
#
# By design there are NO usernames or passwords in this file. Salesforce and SMTP
# credentials are entered in the app UI at connect time, held in memory, and never
# written to disk. Only the resulting Salesforce session id is persisted, to
# data/sessions/<env>.json with 0600 permissions, and only until it expires.

PORT=4317

# Which environment the app opens on: testing | staging
DEFAULT_ENV=testing

# Playwright login window. false = you watch the login happen and can intervene.
HEADLESS=false

# Optional: pre-fill the Salesforce username field in the connect form (not a secret).
# The password and MFA code are always typed into the app, never stored.
# SF_USERNAME_HINT=someone@netradyne.com.testing

# Optional: pre-fill the SMTP username field in the connect form (not a secret).
# SMTP_USERNAME_HINT=someone@netradyne.com

# --- Outlook on the web (mail transport) -----------------------------------
# SMTP is unusable in this tenant (535 5.7.139 = SMTP AUTH disabled), so mail goes out
# through Outlook on the web. Sign in once on the Connect screen and the session is saved
# to outlook-auth.json in the project root, at mode 0600, and reused silently after that.
#
# To reuse an existing session instead of signing in again, point this at it:
# OUTLOOK_AUTH_STATE_PATH=/Users/you/BSG/bsg-qa-agent/outlook-auth.json
#
# Timeouts, all with sensible defaults — raise them on a slow mailbox:
# OUTLOOK_SEND_CONFIRM_MS=120000    # how long a Send press gets to be confirmed
# OUTLOOK_SENT_VERIFY_MS=180000     # how long to wait for the message to reach Sent Items
# OUTLOOK_HYDRATION_MS=45000        # how long OWA gets to render before the session is called dead
